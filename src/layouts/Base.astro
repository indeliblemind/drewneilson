---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
interface Props { title: string; description?: string }
const { title, description = 'Questions, work, and experiments by Drew Neilson.' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><meta name="robots" content="noindex, nofollow" /><title>{title} · Drew Neilson</title></head>
<body><a class="skip" href="#main">Skip to content</a><header><a class="logo" href="/">Drew Neilson<span style="color:var(--accent)">.</span></a><nav class="nav" aria-label="Main navigation"><a href="/#work">Work</a><a href="/#thinking">Other things</a><a href="/#map">Connections</a><a href="/#about">About</a></nav></header><main id="main"><slot /></main><Footer /></body></html>
