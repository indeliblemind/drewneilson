---
import type {CollectionEntry} from 'astro:content';
import type {Edge} from '../lib/relations';
import {resumeData} from '../lib/resume-data';
import {presentEvidence} from '../lib/resume-model';
import EvidenceItem from './EvidenceItem.astro';
import {site} from '../data/site';
interface Props {pieces:CollectionEntry<'pieces'>[];edges:Edge[]}
const {pieces,edges}=Astro.props;
const {jobs,contexts,evidence}=resumeData(pieces,edges);
const defaults=presentEvidence(evidence,[],'chronological');
const allOrdered=[...defaults,...evidence.filter(e=>!e.default)];
const independent=[...new Set(evidence.filter(e=>!e.contexts.length).map(e=>e.parentId))];
const activeNodes=pieces.map(p=>({id:p.id,competencies:p.data.competencies??[],accomplishments:(p.data.accomplishments??[]).map(a=>({competencies:a.competencies??[]}))}));
---
<section class="section dynamic-resume" id="resume" aria-labelledby="resume-title">
 <div class="section-head"><h2 class="section-title" id="resume-title">03 / Résumé</h2><div class="resume-modes" role="group" aria-label="Résumé view" hidden><button type="button" class="chip active" data-resume-mode="chronological" aria-pressed="true">Chronological</button><button type="button" class="chip" data-resume-mode="relevance" aria-pressed="false">By relevance</button></div></div>
 <div class="resume-document">
  <header class="resume-heading"><h2>{site.profile.name}</h2><div class="resume-contact">{site.resume.contact.length?site.resume.contact.map(contact=>contact.url?<a href={contact.url}>{contact.label}</a>:<span>{contact.label}</span>):<span>Contact information pending</span>}</div></header>
  <p class="resume-fixed-intro">{site.resume.introduction}</p>
  <p class="resume-development-note">Development résumé · Fictional example evidence, not Drew’s approved career record. Contact and education details await supplied content.</p>
  <p class="resume-evidence-status" data-resume-status role="status" aria-live="polite">Selected professional evidence</p>
  <div data-resume-view="chronological"><h3 class="resume-section-label">Professional experience</h3>
   {jobs.map(job=>{const context=contexts.get(job.id)!;const items=allOrdered.filter(e=>e.groupId===job.id);return <section class="resume-role-block" data-resume-job={job.id}><div class="resume-role-heading"><div><h4>{context.role}</h4><a href={context.url}>{context.employer}</a></div><span>{context.period}</span></div><p class="resume-job-summary">{job.data.summary}</p>{items.length>0&&<ul class="resume-accomplishments" data-evidence-group={job.id}>{items.map(item=><EvidenceItem item={item}/>)}</ul>}</section>;})}
   {independent.length>0&&<section class="resume-independent-evidence"><h3 class="resume-section-label">Independent projects</h3>{independent.map(id=>{const piece=pieces.find(p=>p.id===id)!;return <div><h4><a href={`/pieces/${id}/`}>{piece.data.title}</a></h4><ul class="resume-accomplishments" data-evidence-group={id}>{allOrdered.filter(e=>e.groupId===id).map(item=><EvidenceItem item={item}/>)}</ul></div>;})}</section>}
  </div>
  <div data-resume-view="relevance" hidden><h3 class="resume-section-label">Professional evidence</h3><p class="resume-relevance-note">Employer, role, and dates remain attached to every accomplishment. With no competencies selected, the curated default evidence is shown in editorial order.</p><ul class="resume-accomplishments relevance-evidence" data-relevance-evidence>{allOrdered.map(item=><EvidenceItem item={item} context/>)}</ul></div>
  <section class="resume-education"><h3 class="resume-section-label">Education</h3>{site.resume.education.length?site.resume.education.map(item=><p><strong>{item.qualification}</strong><br/>{item.institution}{item.period&&` · ${item.period}`}</p>):<p class="resume-pending">Education details not yet supplied for this demonstration.</p>}</section>
 </div>
 <script type="application/json" id="resume-data" set:html={JSON.stringify({evidence,nodes:activeNodes}).replace(/</g,'\\u003c')}/>
</section>
<script>import '../scripts/dynamic-resume';</script>
