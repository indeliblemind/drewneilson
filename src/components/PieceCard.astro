---
import type { CollectionEntry } from 'astro:content';
interface Props { piece: CollectionEntry<'pieces'>; compact?: boolean }
const { piece, compact = false } = Astro.props;
const layout = compact ? 'fragment' : piece.data.layout;
---
<article class:list={[layout === 'featured' ? 'featured project' : layout === 'story' ? 'story project' : 'fragment']} id={`project-${piece.id}`}>
  {layout === 'featured' && <div class="feature-art"><div class="art-label">Smash*It · Business / Experience</div></div>}
  <div class:list={[layout === 'featured' && 'feature-content']}>
    <span class="piece-type">{piece.data.kind === 'thought-experiment' ? 'Thought experiment' : 'Story'}</span>
    <span class:list={[layout === 'featured' ? 'kicker' : layout === 'story' ? 'num' : 'status']}>{piece.data.status}</span>
    <h3>{piece.data.title}</h3><p>{piece.data.summary}</p>
    <a class="textlink" href={`/pieces/${piece.id}/`}>Explore this piece ↗</a>
  </div>
</article>
