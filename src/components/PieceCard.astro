---
import type { CollectionEntry } from 'astro:content';
import {kindLabel} from '../lib/content';
interface Props {piece:CollectionEntry<'pieces'>; layout?:'featured'|'secondary'|'compact'}
const {piece,layout='compact'}=Astro.props;
---
<article class:list={[layout==='featured'?'featured project':layout==='secondary'?'story project':'fragment']} id={`project-${piece.id}`}>
 {layout==='featured' && <div class="feature-art demo-art"><div class="art-label">Fictional project · demonstration</div></div>}
 <div class:list={[layout==='featured' && 'feature-content']}>
 <span class="piece-type">{kindLabel(piece.data.kind)}</span>
 {piece.data.status && <span class="status">{piece.data.status}</span>}
 <h3>{piece.data.title}</h3><p>{piece.data.summary}</p>
 {piece.data.attribution && <small>{piece.data.attribution}</small>}
 <a class="textlink" href={`/pieces/${piece.id}/`}>Explore this {piece.data.kind} ↗</a>
 </div>
</article>
