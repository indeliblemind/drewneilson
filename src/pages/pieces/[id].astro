---
import {render,type CollectionEntry} from 'astro:content';
import Base from '../../layouts/ConnectedWork.astro';
import ConnectedHeader from '../../components/ConnectedHeader.astro';
import {getPortfolio,kindLabel,edgeLabel,type Edge} from '../../lib/content';
export async function getStaticPaths(){const {pieces,edges}=await getPortfolio();return pieces.map(piece=>({params:{id:piece.id},props:{piece,pieces,edges}}));}
interface Props{piece:CollectionEntry<'pieces'>;pieces:CollectionEntry<'pieces'>[];edges:Edge[]}
const {piece,pieces,edges}=Astro.props;const {Content}=await render(piece);
const related=edges.filter(e=>e.source===piece.id||e.target===piece.id);
---
<Base title={piece.data.title} description={piece.data.summary}>
 <ConnectedHeader/><p class="demo-banner"><strong>INTERACTION DEMONSTRATION</strong> Existing fictional and test content.</p><article class="page-body"><a href="/#map">← Explore the collection</a><p class="kicker" style="margin-top:30px">{kindLabel(piece.data.kind)}{piece.data.status && ` · ${piece.data.status}`}</p><h1>{piece.data.title}</h1>{piece.data.role && <p>{piece.data.role}</p>}<p class="lead">{piece.data.summary}</p>{piece.data.attribution && <p>{piece.data.attribution}</p>}<Content/>
 <aside class="node-connections" aria-label="Connections"><h2>Connections</h2>{related.length ? <ul>{related.map(edge=>{const other=pieces.find(p=>p.id===(edge.source===piece.id?edge.target:edge.source))!;return <li><span class="connection-relation">{edgeLabel(edge,piece.id)}</span> <a href={`/pieces/${other.id}/`}>{other.data.title}</a><small>{kindLabel(other.data.kind)}</small>{edge.label && <p>{edge.label}</p>}</li>;})}</ul>:<p>This subject stands on its own. A connection isn’t required.</p>}<a class="textlink" href="/#map">Explore the map ↗</a></aside>
 </article>
</Base>
